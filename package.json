{
  "name": "aseprite-chat",
  "displayName": "Aseprite Chat",
  "description": "Chat with Codex and edit the current unsaved sprite through a native Lua interface.",
  "version": "0.5.1",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node scripts/server.mjs",
    "test": "node --test --test-isolation=none tests/*.test.mjs"
  },
  "categories": [
    "Scripts"
  ],
  "contributes": {
    "keys": [
      {
        "id": "aseprite-chat-enter",
        "path": "./chat.aseprite-keys"
      }
    ],
    "scripts": [
      {
        "path": "./main.lua"
      }
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "ws": "8.22.0"
  }
}
